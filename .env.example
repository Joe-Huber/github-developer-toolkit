# Copy to `.env` and fill in your values.
# Precedence (highest first): environment variables > .env > ghdtk.toml > defaults.
#
# A GitHub Personal Access Token is REQUIRED. Create one at
# https://github.com/settings/tokens with read access to the public data the
# analyzer fetches (user, repos, commits, pulls, issues, etc.).
GHDTK_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub API endpoint (override for GitHub Enterprise).
GHDTK_GITHUB_BASE_URL=https://api.github.com

# Per-request timeout in seconds and retry count.
GHDTK_GITHUB_TIMEOUT_SECONDS=30
GHDTK_GITHUB_MAX_RETRIES=3

# Default page size for paginated list/search endpoints (1-100).
GHDTK_GITHUB_PER_PAGE=100

# Cache toggles and default TTL (seconds).
GHDTK_CACHE_ENABLED=true
GHDTK_CACHE_TTL_SECONDS=86400

# Analysis thresholds used by analyzers when producing findings.
GHDTK_ANALYSIS_MINIMUM_STARS=10
GHDTK_ANALYSIS_MINIMUM_COMMITS=5
GHDTK_ANALYSIS_MINIMUM_REPOSITORIES=3
GHDTK_ANALYSIS_README_MIN_CHARS=100
GHDTK_ANALYSIS_STALENESS_DAYS=90

# Optional: point to a config file instead of ./ghdtk.toml.
# GHDTK_CONFIG_FILE=/path/to/ghdtk.toml
